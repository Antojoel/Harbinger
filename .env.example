# Copy this to .env and fill in real values. .env is gitignored — never commit it.

# Razorpay test-mode credentials (from https://dashboard.razorpay.com/app/keys)
# Without these, /api/create-payment-order and /api/payments/order degrade
# gracefully (return {"awaiting_keys": true}) instead of crashing.
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — only needed if you're using it for text/LLM calls elsewhere.
# Scoped AI Grants India key: text-only (gpt-5-nano), no audio models.
OPENAI_API_KEY=

# Google Sign-In (from https://console.cloud.google.com/apis/credentials —
# create an OAuth Client ID, type "Web application"). Without this, the
# dashboard falls back to "Continue as Guest" instead of a hard login wall.
# The same client ID goes in both places — one for the backend to verify
# tokens against, one for the frontend's Google button.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Signs the session tokens we issue after login. Any long random string —
# generate with `openssl rand -hex 32`. Falls back to an insecure dev
# default if unset (fine for a demo, not for anything real).
SESSION_SECRET=
