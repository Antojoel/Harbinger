# Harbinger — copy this to .env and fill in real values. .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# Payments (Razorpay test mode)
# ---------------------------------------------------------------------------
# From https://dashboard.razorpay.com/app/keys. Without these,
# /api/create-payment-order and /api/payments/order degrade gracefully
# (return {"awaiting_keys": true}) instead of crashing.
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Auth (Google Sign-In)
# ---------------------------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials — create an OAuth
# Client ID, type "Web application". Without this, the dashboard falls back to
# "Continue as Guest" instead of a hard login wall. The same client ID goes in
# both places — one for the backend to verify tokens against, one for the
# frontend's Google button.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Signs the session tokens we issue after login. Any long random string —
# generate with `openssl rand -hex 32`. Falls back to an insecure dev default
# if unset (fine for a demo, not for anything real).
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Voice pipeline  (engine: POST /api/voice-query)
# ---------------------------------------------------------------------------
# Which speech backend to use:
#   text_only  no speech; audio_base64 is treated as UTF-8 text (default)
#   openai     OpenAI /audio/transcriptions + /audio/speech
#   gemini     Gemini generateContent for STT + TTS (API key auth)
#   vertex     Vertex AI Gemini for STT + Cloud Text-to-Speech for synthesis
#              (service-account auth, not an API key)
#   local      the bundled `stt` (faster-whisper by default) and `tts` (Kokoro) services
#
# NOTE: this only affects the locked-contract POST /api/voice-query endpoint
# (used by MCP/external clients). The dashboard's own voice widget uses the
# browser's Web Speech API and never touches this setting either way.
VOICE_PROVIDER=text_only

# Needed for VOICE_PROVIDER=openai. Also a scoped AI Grants India key works for
# text/LLM calls elsewhere (text-only gpt-5-nano, no audio models).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Needed for VOICE_PROVIDER=gemini (a simple API key from aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_STT_MODEL=gemini-2.0-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Needed for VOICE_PROVIDER=vertex. This is a GCP *service account* JSON
# (from a project with Vertex AI + Cloud Text-to-Speech APIs enabled and the
# service account granted roles/aiplatform.user), base64-encoded as a single
# line so it survives .env/docker-compose variable substitution cleanly:
#   base64 -i your-service-account.json | pbcopy   (macOS)
# Verified against real Vertex AI + Cloud TTS: gemini-2.5-flash in
# us-central1, TTS -> WAV -> STT round-trip recovered the sentence correctly.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
# VERTEX_STT_MODEL=gemini-2.5-flash
# VERTEX_TTS_VOICE=en-US-Neural2-C

# ---------------------------------------------------------------------------
# Text-to-speech override — a third axis, independent of VOICE_PROVIDER above.
# ---------------------------------------------------------------------------
# VOICE_PROVIDER picks the backend for BOTH transcription and synthesis. The
# best STT and the best TTS are rarely the same service, so TTS_PROVIDER moves
# the speaking half alone somewhere else. Leave it empty (the default) and
# nothing changes: both halves come from VOICE_PROVIDER, exactly as before.
#   smallest   Smallest AI Waves (Lightning) — TTS only, needs no GPU and no
#              local `tts` container. Only reachable on this axis, since Waves
#              has no transcription endpoint.
#   openai | gemini | vertex | local | text_only   as documented above
# The intended combination on a GPU box is VOICE_PROVIDER=local (faster-whisper
# transcribes on CUDA) + TTS_PROVIDER=smallest (Waves speaks). If the override
# can't be built (no key), synthesis silently falls back to VOICE_PROVIDER's
# own TTS rather than going silent.
TTS_PROVIDER=
# API key from https://smallest.ai (Waves). Applies to TTS_PROVIDER=smallest.
SMALLEST_AI_KEY=
# SMALLEST_TTS_MODEL=lightning_v3.1        # or lightning_v3.1_pro
# Voice ids are NOT free-form — Waves 400s ("Invalid Voice ID") on an unknown
# one. List the 234 available voices with:
#   curl -H "Authorization: Bearer $SMALLEST_AI_KEY" \
#        https://api.smallest.ai/waves/v1/lightning-v3.1/get_voices
# (hyphenated model name in that path; underscored in the /tts request body.)
# SMALLEST_TTS_VOICE=srishti
# SMALLEST_TTS_LANGUAGE=en                 # Waves also speaks Hindi and other Indian languages
# SMALLEST_TTS_SAMPLE_RATE=24000
# SMALLEST_TTS_SPEED=1.0                   # 0.5 - 2.0
# SMALLEST_BASE_URL=https://api.smallest.ai/waves/v1

# ---------------------------------------------------------------------------
# Answer wording for POST /api/voice-query - a separate axis from
# VOICE_PROVIDER above. VOICE_PROVIDER picks how audio is transcribed/spoken;
# this picks how response_text is worded. Also overridable per-request via
# {"llm_provider": "..."} in the request body (e.g. the Integrations page's
# "Try the Voice API" panel).
#   heuristic (default)  fixed template read straight from the graph, no LLM
#   openai                grounds an LLM (OPENAI_API_KEY above) in the same
#                          graph facts - falls back to heuristic on any error
#   gemini                same, but via the Vertex AI service account above
#                          (GOOGLE_SERVICE_ACCOUNT_JSON_B64/VERTEX_PROJECT_ID)
#                          - deliberately NOT GEMINI_API_KEY/AI Studio, to
#                          reuse the one GCP credential this project already
#                          has configured and verified live
# On failure (missing key, network error, malformed response) this always
# falls back to the heuristic template rather than breaking the query.
LLM_ANSWER_PROVIDER=heuristic
# Verified live against a gpt-5-nano-only OpenAI key: gpt-5-nano is a
# reasoning model - it rejects `temperature` (must be its default, 1) and
# `max_tokens` (needs `max_completion_tokens` instead, which llm_answer.py
# already sends), and spends several hundred completion tokens on hidden
# reasoning before the visible answer, hence the generous 1500-token budget
# in llm_answer.py. Override here if your key has access to a cheaper model
# (e.g. gpt-4o-mini) - it works fine too, just without the reasoning tax.
# LLM_ANSWER_MODEL=gpt-5-nano

# ---------------------------------------------------------------------------
# Local speech services  (only used when VOICE_PROVIDER=local)
# ---------------------------------------------------------------------------
# STT engine:
#   faster_whisper  Whisper on CTranslate2 (default) — accurate, CUDA-accelerated
#   sherpa          streaming Zipformer / Kroko transducer — light, CPU-only
STT_ENGINE=faster_whisper
# faster-whisper model: tiny.en | base.en | small.en | distil-small.en |
#                       distil-large-v3 | large-v3 ...
STT_WHISPER_MODEL=small.en
# STT_DEVICE=auto           # auto | cpu | cuda
# STT_COMPUTE_TYPE=auto     # auto | float16 | int8 | int8_float16
# STT_LANGUAGE=en           # "" to autodetect
# STT_BEAM_SIZE=5

# sherpa engine only — for the real Kroko community models:
# STT_HF_REPO=Banafo/test-onnx
# STT_HF_TOKEN=

# TTS (Kokoro): "auto" | "cpu" | "cuda". "auto" uses the GPU when present.
KOKORO_DEVICE=auto
# KOKORO_VOICE=af_heart
# CUDA torch wheel for the tts image build (default targets CUDA 12.x):
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
# For a CPU-only tts image: TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# ---------------------------------------------------------------------------
# Neo4j (defaults match docker-compose)
# ---------------------------------------------------------------------------
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
