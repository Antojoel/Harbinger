# Harbinger — copy this to .env and fill in real values. .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# Payments (Razorpay test mode)
# ---------------------------------------------------------------------------
# From https://dashboard.razorpay.com/app/keys. Without these,
# /api/create-payment-order and /api/payments/order degrade gracefully
# (return {"awaiting_keys": true}) instead of crashing.
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Auth (Google Sign-In)
# ---------------------------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials — create an OAuth
# Client ID, type "Web application". Without this, the dashboard falls back to
# "Continue as Guest" instead of a hard login wall. The same client ID goes in
# both places — one for the backend to verify tokens against, one for the
# frontend's Google button.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Signs the session tokens we issue after login. Any long random string —
# generate with `openssl rand -hex 32`. Falls back to an insecure dev default
# if unset (fine for a demo, not for anything real).
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Voice pipeline  (engine: POST /api/voice-query)
# ---------------------------------------------------------------------------
# Which speech backend to use:
#   text_only  no speech; audio_base64 is treated as UTF-8 text (default)
#   openai     OpenAI /audio/transcriptions + /audio/speech
#   gemini     Gemini generateContent for STT + TTS
#   local      the bundled `stt` (sherpa-onnx / Kroko) and `tts` (Kokoro) services
VOICE_PROVIDER=text_only

# Needed for VOICE_PROVIDER=openai. Also a scoped AI Grants India key works for
# text/LLM calls elsewhere (text-only gpt-5-nano, no audio models).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Needed for VOICE_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_STT_MODEL=gemini-2.0-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ---------------------------------------------------------------------------
# Local speech services  (only used when VOICE_PROVIDER=local)
# ---------------------------------------------------------------------------
# STT: default model is public and needs no token. For the real Kroko
# community models, point at their repo and supply a token:
# STT_HF_REPO=Banafo/test-onnx
# STT_HF_TOKEN=

# TTS (Kokoro): "auto" | "cpu" | "cuda". "auto" uses the GPU when present.
KOKORO_DEVICE=auto
# KOKORO_VOICE=af_heart

# ---------------------------------------------------------------------------
# Neo4j (defaults match docker-compose)
# ---------------------------------------------------------------------------
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
